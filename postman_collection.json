              "raw": "{\n  \"id\": {{productId}},\n  \"name\": \"Notebook Atualizado\",\n  \"description\": \"Notebook atualizado\",\n  \"quantity\": 12,\n  \"value\": 3600.00\n}"
            },
            "url": {
