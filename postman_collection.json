              "raw": "{\n  \"name\": \"Notebook\",\n  \"description\": \"Notebook para o laboratório\",\n  \"quantity\": 10,\n  \"value\": 3500.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
